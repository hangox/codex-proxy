node_modules/
dist/
dist-electron/
release/
public-desktop/
data/
# Opaque compact's master keyring default location when running from source
# (a sibling of data/, computed by getDefaultOpaqueCompactKeyringFile() in
# src/paths.ts). This is a real, irreversible encryption key for whatever
# opaque compact state exists locally — must never be committed, same as
# data/ above.
opaque-keys/
public/
docs/
bin/*
!bin/README.md

# packages/electron/{bin,config,native}/ are build-time COPIES of the
# root-level bin/、config/、native/ directories, generated by
# packages/electron/electron/prepare-pack.mjs before electron-builder
# runs (and left behind by running the electron test suite locally,
# e.g. prepare-pack.test.ts / release-pipeline.test.ts) — not source.
#
# The rules above don't reach them: a pattern containing a "/" other
# than a trailing one (like `bin/*`) is anchored to the .gitignore's own
# directory (repo root) per git's own semantics, so it never matches at
# other depths — that's why `packages/electron/bin/` slipped through.
# `config/`/`native/` have no blanket root-level ignore rule at all
# (correctly so: the ROOT `config/`/`native/` directories are real
# tracked source — config/default.yaml, native/*.rs, etc. — only their
# packages/electron/ copies are generated). packages/electron/public/
# needs no separate entry: the bare `public/` rule above (no other "/")
# already matches at any depth.
packages/electron/bin/
packages/electron/config/
packages/electron/native/
.env
*.log
.asar-out/
tmp/
.claude/*
!.claude/skills/
native/target/
native/codex-tls.linux-*.node

# Maintenance scripts (private)
scripts/manual-test/
scripts/cron-update.sh

# Local captures may contain proprietary upstream prompt text.
tests/_fixtures/local/

# Design / internal files
stitch-designs/
stitch-screens/
# CLAUDE.md 现已纳入版本控制——它是给 AI agent 的强约束提醒，
# 内含真实发布事故的教训，需要跨机器、跨会话共享，不能只存在本地。
*.tar.gz
stitch-output/
